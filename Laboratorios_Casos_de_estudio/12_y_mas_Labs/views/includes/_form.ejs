<% if(editar) { %>
<form action="/videojuegos/edit" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="id" value="<%= videojuego.id %>">
<% } else { %>
<form action="/videojuegos/new" method="POST" enctype="multipart/form-data">
<% } %>

<input type="hidden" name="_csrf" value="<%= csrfToken %>">

<div class="field">
  <label for="nombre" class="label">Nombre</label>
  <div class="control">
    <input id="nombre" name="nombre" class="input" type="text" placeholder="e.g Minecraft"
    <% if(editar) { %>
      value="<%= videojuego.nombre %>"
    <% } %>>
  </div>
</div>

<div class="field">
  <div class="select">
    <select id="tipo" name="tipo">
      <% for (let i = 0; i < tipos.length; i++) { %>
        <% let tipo = tipos[i]; %>
        <option value="<%= tipo.id %>"
          <% if (editar && videojuego.tipo == tipo.nombre) { %>
            selected
          <% } %>>
          <%= tipo.nombre %>
        </option>
      <% } %>
    </select>
  </div>
</div>

<div class="field">
  <label for="imagen" class="label">Imagen</label>
  <div class="control">
    <input id="imagen" name="imagen" class="input" type="file">
  </div>
</div>

<input class="button is-primary" type="submit" value="Guardar">

</form>